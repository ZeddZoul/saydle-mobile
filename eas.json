{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "APPLE_TEAM_ID": "CXH9CWA254"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.saydle.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_okTnHmATDkxrepRZgxMmvGMPJad",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "premium",
        "APPLE_TEAM_ID": "CXH9CWA254"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.saydle.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_okTnHmATDkxrepRZgxMmvGMPJad",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "premium",
        "APPLE_TEAM_ID": "CXH9CWA254"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
