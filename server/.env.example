# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/saydle

# --- Auth -------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# These must be different from each other.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Access token lifetime (any ms-style duration string)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime, in days
REFRESH_TOKEN_TTL_DAYS=30
# Absolute lifetime of a refresh *family*, in days. Every refresh mints a fresh
# token, so without a ceiling a session never has to sign in again.
REFRESH_FAMILY_MAX_DAYS=180

# Keys the HMAC in the deletion tombstone. Dedicated so rotating the auth
# secrets above never breaks matching old tombstones. REQUIRED in production;
# outside it the server falls back to JWT_REFRESH_SECRET with a warning.
# TOMBSTONE_HMAC_KEY=replace-me

# Signs the short-lived URLs a reader's own "My words" clips are served under.
# REQUIRED in production; outside it falls back to JWT_ACCESS_SECRET with a warning.
# CLIP_SIGNING_SECRET=replace-me

# --- Email -------------------------------------------------------------------
# Password-reset and verification codes. REQUIRED in production (the server
# refuses to boot without it). Leave unset in development and mail is not sent:
# the log records that a message was skipped, never its body, so read the code
# from the passwordresettokens / emailverificationtokens collection if you need
# to complete the flow locally without a provider account.
# RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Saydle <noreply@saydle.app>

# --- Vertex AI --------------------------------------------------------------
# Set false to run entirely on the curated affirmation bank — the switch to flip
# if Vertex is misbehaving in production. When true, GOOGLE_CLOUD_PROJECT is required.
AI_ENABLED=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Credentials are read via Application Default Credentials. On a cloud host,
# attach a service account to the service and leave this unset — there is then no
# secret to leak or rotate.
#
# Locally, set it. Two reasons it beats `gcloud auth application-default login`:
# ADC is a single global file, so logging in for another project silently breaks
# Vertex here (a 403 that degrades quietly to the curated bank, not an error you
# would notice); and this is the same mechanism production uses. Keep the key
# OUTSIDE the repo — ~/.config/saydle/ rather than anywhere under it.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Explicit context caching bills per token-hour whether or not you hit it.
# Gemini 2.5 applies implicit caching to a repeated prefix at no storage cost, so
# leave this off until traffic is steady enough to justify it.
AI_EXPLICIT_CACHE=false
AI_CACHE_TTL_SECONDS=3600
AI_TIMEOUT_MS=120000

# --- Feed -------------------------------------------------------------------
# How many future days to keep scheduled per user, so the phone always has
# something cached for offline use.
FEED_BUFFER_DAYS=14
# Ceiling on how much one sync request may pull down.
FEED_MAX_SYNC_DAYS=30

# --- Misc -------------------------------------------------------------------
# Comma-separated allowed origins. The Expo client sends no Origin header, so
# this only matters for the web build.
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info

# --- In-app purchases (RevenueCat) -------------------------------------------
# Publishable keys. Safe to inline: they identify the app and grant nothing on
# their own. Leave blank and the paywall runs on the free trial only, which is
# the right setup until there is a store listing.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# Server side of the same contract. Must equal the entitlement *identifier* in
# the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID=premium
# Shared secret RevenueCat sends in the webhook's Authorization header. Unset,
# the webhook refuses every event (fails closed) and production warns at boot.
# REVENUECAT_WEBHOOK_SECRET=

# --- Voice (ElevenLabs) ------------------------------------------------------
# Renders the listening session. Server-side only, and deliberately not an
# EXPO_PUBLIC_* var: those are inlined into the bundle at build time, so putting
# this key there would ship it to every phone. The app is handed audio files, it
# never talks to ElevenLabs.
#
# Audio is cached per (text, voiceId). Voice is 10-20x the AI cost and the only
# line that scales with engagement, which is why a voice change takes effect the
# next day rather than discarding today's renders.
ELEVENLABS_API_KEY=
# Characters one account may have rendered on its behalf per rolling 24h.
# Cache hits are free and do not count. Past it, lines come back without a
# clip and the device reads them.
VOICE_DAILY_CHAR_BUDGET=5000

# --- Library -----------------------------------------------------------------
# Tunables for the scrollable library; the reasoning is in src/config/library.js.
# All must be positive integers — a typo fails at boot.
LIBRARY_BATCH_SIZE=240
LIBRARY_REFILL_BELOW=40
LIBRARY_STALE_DAYS=6
LIBRARY_DRIFT_PERCENT=50
LIBRARY_PAGE_SIZE=40

# --- Account deletion --------------------------------------------------------
# Policy in src/config/deletion.js. Positive integers; the reminder must come
# before the purge.
DELETION_GRACE_DAYS=30
DELETION_REMINDER_DAYS=5
BILLING_RETENTION_YEARS=6
