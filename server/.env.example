# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# MongoDB connection string (Atlas or local)
# Atlas needs the database NAME before the query string. Omit it and the
# driver silently connects to a database called "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/saydle?appName=saydle

# --- Auth -------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# These must be different from each other.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Access token lifetime (any ms-style duration string)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime, in days
REFRESH_TOKEN_TTL_DAYS=30

# --- Email -------------------------------------------------------------------
# Password-reset codes. Leave unset in development and codes are logged instead
# of sent, so the flow works without a provider account.
# RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Saydle <noreply@saydle.app>

# --- Vertex AI --------------------------------------------------------------
# Set false to run entirely on the curated affirmation bank — the switch to flip
# if Vertex is misbehaving in production. When true, GOOGLE_CLOUD_PROJECT is required.
AI_ENABLED=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Credentials are read via Application Default Credentials. On a cloud host,
# attach a service account to the service and leave this unset — there is then no
# secret to leak or rotate.
#
# Locally, set it. Two reasons it beats `gcloud auth application-default login`:
# ADC is a single global file, so logging in for another project silently breaks
# Vertex here (a 403 that degrades quietly to the curated bank, not an error you
# would notice); and this is the same mechanism production uses. Keep the key
# OUTSIDE the repo — ~/.config/saydle/ rather than anywhere under it.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Explicit context caching bills per token-hour whether or not you hit it.
# Gemini 2.5 applies implicit caching to a repeated prefix at no storage cost, so
# leave this off until traffic is steady enough to justify it.
AI_EXPLICIT_CACHE=false
AI_CACHE_TTL_SECONDS=3600
AI_TIMEOUT_MS=120000

# --- Feed -------------------------------------------------------------------
# How many future days to keep scheduled per user, so the phone always has
# something cached for offline use.
FEED_BUFFER_DAYS=14
# Ceiling on how much one sync request may pull down.
FEED_MAX_SYNC_DAYS=30

# --- Misc -------------------------------------------------------------------
# Comma-separated allowed origins. The Expo client sends no Origin header, so
# this only matters for the web build.
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info

# --- In-app purchases (RevenueCat) -------------------------------------------
# The EXPO_PUBLIC_* publishable keys belong to the APP, in the root .env, not
# here. What the server needs is the pair below.
#
# The entitlement IDENTIFIER from the dashboard, not its display name, and
# byte-identical to EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID in the root .env.
# A mismatch means entitlements.active[id] is forever undefined: every paying
# customer keeps seeing the paywall and nothing logs an error anywhere.
#
# Unquoted here on purpose. node --env-file strips quotes, but a host that
# takes the line literally (Railway's raw editor) would ship them as part of
# the value, which is the same silent mismatch by another route.
REVENUECAT_ENTITLEMENT_ID=Saydle Pro

# Signs the webhook, which is the only path that may mark a subscription
# verified. Without it the server cannot trust a single purchase event.
REVENUECAT_WEBHOOK_SECRET=

# --- Voice (ElevenLabs) ------------------------------------------------------
# Renders the listening session. Server-side only, and deliberately not an
# EXPO_PUBLIC_* var: those are inlined into the bundle at build time, so putting
# this key there would ship it to every phone. The app is handed audio files, it
# never talks to ElevenLabs.
#
# Audio is cached per (text, voiceId). Voice is 10-20x the AI cost and the only
# line that scales with engagement, which is why a voice change takes effect the
# next day rather than discarding today's renders.
ELEVENLABS_API_KEY=

# --- Translation (DeepL) -----------------------------------------------------
# Read only by `pnpm translate <locale>`, a build-time tool.
DEEPL_API_KEY=
