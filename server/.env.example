# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/saydle

# --- Auth -------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# These must be different from each other.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Access token lifetime (any ms-style duration string)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime, in days
REFRESH_TOKEN_TTL_DAYS=30

# --- Email -------------------------------------------------------------------
# Password-reset codes. Leave unset in development and codes are logged instead
# of sent, so the flow works without a provider account.
# RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Saydle <noreply@saydle.app>

# --- Vertex AI --------------------------------------------------------------
# Set false to run entirely on the curated affirmation bank — the switch to flip
# if Vertex is misbehaving in production. When true, GOOGLE_CLOUD_PROJECT is required.
AI_ENABLED=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Credentials are read via Application Default Credentials. Locally, point this at
# a service-account key file. On a cloud host, prefer the platform's attached
# identity and leave it unset.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Explicit context caching bills per token-hour whether or not you hit it.
# Gemini 2.5 applies implicit caching to a repeated prefix at no storage cost, so
# leave this off until traffic is steady enough to justify it.
AI_EXPLICIT_CACHE=false
AI_CACHE_TTL_SECONDS=3600
AI_TIMEOUT_MS=30000

# --- Feed -------------------------------------------------------------------
# How many future days to keep scheduled per user, so the phone always has
# something cached for offline use.
FEED_BUFFER_DAYS=14
# Ceiling on how much one sync request may pull down.
FEED_MAX_SYNC_DAYS=30

# --- Misc -------------------------------------------------------------------
# Comma-separated allowed origins. The Expo client sends no Origin header, so
# this only matters for the web build.
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info

# --- In-app purchases (RevenueCat) -------------------------------------------
# Publishable keys. Safe to inline: they identify the app and grant nothing on
# their own. Leave blank and the paywall runs on the free trial only, which is
# the right setup until there is a store listing.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
