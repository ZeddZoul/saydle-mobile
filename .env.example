# Mobile app config. Copy to `.env`. Expo inlines every EXPO_PUBLIC_* var at
# build time, so NOTHING secret may go here — these values ship inside the app.

# Where the Saydle API lives.
#  - iOS simulator / web:      http://localhost:4000
#  - Android emulator:         http://10.0.2.2:4000
#  - Physical device:          http://<your-machine-LAN-IP>:4000  (e.g. 192.168.1.20)
# Leave unset to use the per-platform default in lib/config.js.
# Inlined at BUILD time, so whatever is set when you build is what ships.
# A standalone build with localhost reaches nothing on a real phone. The preview
# and production profiles therefore take this from EAS environment variables
# (never from this file), and scripts/check-release-env.mjs refuses to build
# either profile while it is unset, http://, or a placeholder.
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Legal --------------------------------------------------------------------
# Shown on the paywall, the billing screen, Profile and the landing screen.
# Apple requires working Privacy Policy and Terms of Use links wherever a
# subscription is sold. Defaults live in lib/legal.js; override per build here.
EXPO_PUBLIC_PRIVACY_URL=https://saydle.app/privacy
EXPO_PUBLIC_TERMS_URL=https://saydle.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@saydle.app

# Build-time only: fills missing keys in locales/<code>.json from English.
# Never read by the app or the API — see `pnpm translate`.
# Free key: https://www.deepl.com/pro-api
DEEPL_API_KEY=

# --- In-app purchases (RevenueCat) -------------------------------------------
# Publishable keys. Safe to inline: they identify the app and grant nothing on
# their own. Blank means the paywall shows no plans and only the free path,
# which is fine locally. A store build REQUIRES the real appl_/goog_ key — a
# test_ key is RevenueCat's Test Store, which App Review rejects — and the
# release check refuses to build without one.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# --- Server-side (server/.env) -----------------------------------------------
# The SECRET half of RevenueCat. This is what actually grants entitlement: the
# webhook is the only path that may mark a subscription verified, and with this
# unset it refuses every request rather than accepting unauthenticated changes.
# Set it in the RevenueCat dashboard under Integrations → Webhooks.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=premium

# --- Home-screen widget ------------------------------------------------------
# Apple Developer team ID, used to sign the widget extension. Find it at
# https://developer.apple.com/account under Membership. Read by app.config.js
# (app.json cannot substitute variables). Needed for a native build
# (`npx expo prebuild && npx expo run:ios`) and REQUIRED as an EAS environment
# variable for the preview and production profiles; never for Expo Go.
APPLE_TEAM_ID=

# --- AI generation (server/.env) ---------------------------------------------
# Affirmations are generated by Vertex AI ahead of time, never on the read path.
# Leave AI_ENABLED=false to run entirely on the curated bank — everything works,
# the lines are just hand-written. Turning it on REQUIRES GOOGLE_CLOUD_PROJECT;
# the server refuses to boot otherwise rather than silently degrading.
AI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
# Credentials come from Application Default Credentials, never from code:
#   gcloud auth application-default login
# or point GOOGLE_APPLICATION_CREDENTIALS at a service-account key file.
GOOGLE_APPLICATION_CREDENTIALS=
# Explicit context caching bills per token-hour whether or not it is hit, so it
# is off until there is steady volume. Gemini 2.5 caches a repeated prefix
# implicitly at no cost in the meantime.
AI_EXPLICIT_CACHE=false
AI_CACHE_TTL_SECONDS=3600
AI_TIMEOUT_MS=30000
