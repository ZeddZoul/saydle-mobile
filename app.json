{
  "expo": {
    "name": "saydle-mobile",
    "scheme": "saydleapp",
    "slug": "saydle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7CAC5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.saydle-mobile",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.anonymous.saydle-mobile.widget"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F7CAC5"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7CAC5",
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6F61"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "@bittingz/expo-widgets",
        {
          "ios": {
            "src": "./widgets/ios",
            "devTeamId": "$APPLE_TEAM_ID",
            "mode": "development",
            "moduleDependencies": [
              "Module.swift"
            ],
            "useLiveActivities": false,
            "frequentUpdates": false,
            "entitlements": {
              "com.apple.security.application-groups": [
                "group.com.anonymous.saydle-mobile.widget"
              ]
            }
          },
          "android": {
            "src": "./widgets/android",
            "widgets": [
              {
                "name": "SaydleWidgetProvider",
                "resourceName": "@xml/saydle_widget_info"
              }
            ]
          }
        }
      ]
    ]
  }
}
